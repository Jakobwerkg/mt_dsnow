# Keep dependency manifests (they are .txt but are code, not data)
!requirements.txt
!**/requirements.txt

# Keep the small Morris design/response arrays so the sensitivity
# figures can be regenerated without re-running the multi-hour sweep.
*.npy
!par_sens/morris_*/morris_[xy]_flat_*.npy

